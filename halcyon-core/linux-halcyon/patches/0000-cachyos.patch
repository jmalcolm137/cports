+++ cachyos-7.3.1-1/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c	2026-10-30 07:43:42.000000000 -0700
@@ -2652,9 +2652,13 @@
 	wait_event_timeout(devinfo->mbdata_resp_wait, devinfo->mbdata_completed,
 			   BRCMF_PCIE_MBDATA_TIMEOUT);
