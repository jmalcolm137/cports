 #include <LibGfx/Painter.h>
 #include <cmath>
 #include <drm_fourcc.h>
@@ -156,6 +157,27 @@
     wlr_buffer_drop(buffer);
 }
 
+wlr_scene_node* scene_surface_node_at(wlr_scene_node& root, double lx, double ly, double* sx, double* sy)
+{
+    Vector<wlr_scene_node*> skipped;
+    wlr_scene_node* node = nullptr;
+    for (;;) {
+        node = wlr_scene_node_at(&root, lx, ly, sx, sy);
+        if (!node || node->type == WLR_SCENE_NODE_TREE)
+            break;
+        if (node->type == WLR_SCENE_NODE_BUFFER
+            && wlr_scene_surface_try_from_buffer(wlr_scene_buffer_from_node(node)))
+            break;
+        // Chrome (cursor highlight, geometry HUD, shadows) is drawn above the
+        // windows. Hide it for the hit test and try the node underneath.
+        wlr_scene_node_set_enabled(node, false);
+        skipped.append(node);
+    }
+    for (auto* skipped_node : skipped)
+        wlr_scene_node_set_enabled(skipped_node, true);
+    return node;
+}
