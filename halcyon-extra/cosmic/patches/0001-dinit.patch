+/// Dinit implementation of ServiceManager.
+#[cfg(feature = "dinit")]
+pub struct DinitServiceManager {
+    service_name: String,
+}
+
+#[cfg(feature = "dinit")]
+impl DinitServiceManager {
+    pub fn new(service_name: impl Into<String>) -> Self {
+        Self {
+            service_name: service_name.into(),
+        }
+    }
+
+    fn dinit_name(&self) -> &str {
+        // Chimera's BlueZ service is named bluetoothd.
+        if self.service_name == "bluetooth" {
+            "bluetoothd"
+        } else {
+            &self.service_name
+        }
+    }
+
+    fn helper(action: &str, service: &str) -> std::process::Command {
+        let mut command = std::process::Command::new("pkexec");
+        command.args(["/usr/lib/cosmic-dinit-service", action, service]);
+        command
+    }
+}
+
+#[cfg(feature = "dinit")]
+impl ServiceManager for DinitServiceManager {
+    fn is_enabled(&self) -> bool {
+        let name = self.dinit_name();
+        std::path::Path::new("/usr/lib/dinit.d/boot.d")
+            .join(name)
+            .exists()
+            || std::path::Path::new("/etc/dinit.d/boot.d")
+                .join(name)
+                .exists()
+    }
+
+    fn is_active(&self) -> bool {
+        Self::helper("is-active", self.dinit_name())
+            .status()
+            .map(|status| status.success())
+            .unwrap_or(false)
+    }
+
+    fn activate(&self) -> Pin<Box<dyn Future<Output = ()> + Send>> {
+        let service = self.dinit_name().to_owned();
+        Box::pin(async move {
+            let mut command = tokio::process::Command::new("pkexec");
+            command.args(["/usr/lib/cosmic-dinit-service", "start", service.as_str()]);
+            let result = command.status().await;
+            log_command_result(&result, "dinitctl start", &service);
+        })
+    }
+
+    fn enable(&self) -> Pin<Box<dyn Future<Output = ()> + Send>> {
+        let service = self.dinit_name().to_owned();
+        Box::pin(async move {
+            let mut command = tokio::process::Command::new("pkexec");
+            command.args(["/usr/lib/cosmic-dinit-service", "enable", service.as_str()]);
+            let result = command.status().await;
+            log_command_result(&result, "dinitctl enable", &service);
+        })
+    }
+
+    fn is_installed(&self) -> bool {
+        let name = self.dinit_name();
+        std::path::Path::new("/usr/lib/dinit.d").join(name).exists()
+            || std::path::Path::new("/etc/dinit.d").join(name).exists()
+    }
+}
